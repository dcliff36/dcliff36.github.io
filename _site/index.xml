background-color: null;
font-style: inherit;">"department"</span>).agg([</span>
<span id="cb3-13">    pl.col(<span class="st" style="color: #20794D;
background-color: null;
font-style: inherit;">"salary"</span>).mean().alias(<span class="st" style="color: #20794D;
